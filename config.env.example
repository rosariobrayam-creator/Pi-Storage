# Copy to config.env and edit. Loaded by the systemd service (or `source` it manually).

# --- accounts -------------------------------------------------------------

# Signs session cookies. If unset, a key is generated once and saved to
# secret.key next to app.py. Either way it MUST persist across restarts, or
# every restart signs everyone out.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#SECRET_KEY=

# Required to open the /signup page. Leave unset and signup returns 503 --
# create accounts on the Pi with: python app.py create-user <name>
#INVITE_CODE=

# Set to 1 only behind HTTPS (Caddy/Tailscale). On plain http:// the browser
# silently drops a Secure cookie, so login appears to work but never sticks.
#SESSION_COOKIE_SECURE=0

# Set to 1 if a reverse proxy sits in front, so rate limiting sees real client
# IPs instead of the proxy's.
#TRUST_PROXY=0

# --- legacy shared key ----------------------------------------------------

# Pre-multi-user API key. While ALLOW_LEGACY_KEY=1 it still works for uploads
# and they're attributed to the first admin account, so an existing iPhone
# Shortcut keeps running through the upgrade. Once the Shortcut uses a personal
# token (see /account), set ALLOW_LEGACY_KEY=0.
#API_KEY=
ALLOW_LEGACY_KEY=1

# --- storage --------------------------------------------------------------

# Where photos are stored (defaults to ./photos next to app.py)
#PHOTOS_DIR=/home/prdx/photo-server/photos

# Derived from PHOTOS_DIR unless set: .thumbs and .display cache dirs.
#THUMBS_DIR=
#DISPLAY_DIR=
#DB_PATH=/home/prdx/photo-server/photos.db
#LOG_DIR=/home/prdx/photo-server/logs

# Max size of one upload request in MB (all files in the request combined)
MAX_UPLOAD_MB=200

# Refuse uploads when free disk space drops below this many MB
MIN_FREE_MB=500

#HOST=0.0.0.0
PORT=8000
